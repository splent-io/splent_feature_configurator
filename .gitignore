__pycache__/
*.egg-info

# PyCharm / JetBrains IDE files
.idea/

# VS Code files
.vscode

# Log files
app.log
app.log.*

# macOS system files
.DS_Store

# Build artifacts and distribution directories
build/
dist/

# Webpack bundles and source maps
*.bundle.js
*.bundle.js.map
*.map

# Coverage reports
.coverage
htmlcov/

